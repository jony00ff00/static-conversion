{
  "name": "static-conversion",
  "version": "0.0.1",
  "private": true,
  "description": "Deterministic web-to-print visual editor: break HTML/CSS/JS into components and lay them out on A4 pages.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden": "tsx scripts/golden.ts",
    "golden:update": "tsx scripts/golden.ts --update",
    "fixtures:vendor": "tsx scripts/vendor-fixtures.ts",
    "render": "tsx scripts/render.ts",
    "export": "tsx scripts/export.ts",
    "export:test-page": "tsx scripts/export-test-page.ts",
    "dev": "tsx src/server/server.ts",
    "start": "tsx src/server/server.ts",
    "build:static": "tsx scripts/build-static.ts",
    "preview:static": "tsx scripts/serve-static.ts"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "linkedom": "0.18.15",
    "pdf-lib": "1.17.1",
    "pixelmatch": "8.0.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource/inter": "5.1.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "axe-core": "4.14.1",
    "bootstrap": "5.3.3",
    "chart.js": "4.4.4",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.14",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
